{
  "name": "yunshu-dmp",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "云数中台 DMP · 默认启动运营端 mt-web（Vue3 + Vite + Arco）",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "dev:mt": "npm run dev --prefix mt-web",
    "dev:v8": "npm run dev --prefix v8-web",
    "dev:portal": "npm run dev --prefix portal-web",
    "build:v8": "npm run build --prefix v8-web",
    "build:portal": "npm run build --prefix portal-web",
    "install:all": "npm install --prefix mt-web && npm install --prefix v8-web && npm install --prefix portal-web"
  },
  "dependencies": {
    "@arco-design/web-vue": "^2.57.0",
    "axios": "^1.12.2",
    "echarts": "^6.1.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "pinia": "^3.0.3",
    "vue": "^3.5.21",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.5",
    "@vitejs/plugin-vue": "^6.0.1",
    "sass": "^1.81.0",
    "typescript": "~5.6.3",
    "vite": "^7.1.5",
    "vue-tsc": "~2.1.6"
  },
  "engines": {
    "node": ">=18"
  }
}
